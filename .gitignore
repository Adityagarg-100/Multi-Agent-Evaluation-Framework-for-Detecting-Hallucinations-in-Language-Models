# ==========================================
# 1. Credentials & Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
client_secret.json

# ==========================================
# 2. Data & Datasets
# ==========================================
# Ignore the entire data directory's contents, but not the directory itself
data/*
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Ignore common massive data formats anywhere in the repo
*.csv
*.tsv
*.dat
*.jsonl
*.parquet
*.h5
*.hdf5
*.nc
*.pkl
*.pickle

# ==========================================
# 3. AI / ML Models & Checkpoints
# ==========================================
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.pb
*.tflite
*.weights
*.h5

# Machine Learning experiment tracking
wandb/
.neptune/
mlruns/
lightning_logs/
huggingface/

# ==========================================
